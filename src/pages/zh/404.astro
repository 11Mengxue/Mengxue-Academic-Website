---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="页面未找到 | Mengxue Yao" description="无法找到所请求的页面。" locale="zh">
  <section class="page-hero" style="min-height:70vh;display:grid;align-items:center">
    <div class="shell">
      <p class="eyebrow">404</p>
      <h1>页面未找到。</h1>
      <p>此页面可能已在独立重建过程中移动。</p>
      <a class="button" href="/zh/">返回首页</a>
    </div>
  </section>
</BaseLayout>
