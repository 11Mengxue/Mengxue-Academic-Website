---
import{getCollection}from'astro:content';import NewsDetail from '../../../components/NewsDetail.astro';
export async function getStaticPaths(){const items=await getCollection('news',({data})=>data.locale==='zh'&&!data.draft);return items.map(entry=>({params:{slug:entry.data.routeSlug},props:{entry}}))}const{entry}=Astro.props;
---
<NewsDetail entry={entry} locale="zh" />
