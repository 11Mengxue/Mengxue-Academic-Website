---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, type Locale } from '../lib/site';
interface Props {locale:Locale} const {locale}=Astro.props; const zh=locale==='zh';
---
<BaseLayout title={`${zh?'关于':'About'} | Mengxue Yao`} description={zh?'姚梦雪的研究简介与合作方向。':'Research profile and collaboration interests for Mengxue Yao.'} locale={locale}>
  <header class="page-hero"><div class="shell"><div class="breadcrumb">{zh?'首页 / 关于':'Home / About'}</div><p class="eyebrow">{zh?'个人简介':'Profile'}</p><h1>{zh?'以环境研究推动更健康、更具韧性的城市。':'Advancing healthier and more resilient cities through environmental research.'}</h1></div></header>
  <section class="section"><div class="shell case-layout"><div class="portrait-wrap" style="max-width:430px"><img src="/media/mengxue-yao-portrait.jpg" alt={zh?'姚梦雪个人照片':'Portrait of Mengxue Yao'} width="800" height="1000" decoding="async"/></div><div class="prose"><h2>{zh?'关于我':'About me'}</h2><p>{zh?'姚梦雪的研究位于环境建模、城市形态分析与数据科学的交叉领域。她关注城市形态、植被与人类活动如何共同影响空气质量，并探索如何将高分辨率、多源数据转化为可被规划实践使用的证据。':'Mengxue Yao works at the intersection of environmental modelling, urban form analysis and data science. Her research investigates how urban form, vegetation and human activity shape air quality, and how high-resolution, multi-source data can become useful evidence for planning practice.'}</p><p>{zh?'她的研究方法包括空间分析、遥感、街景图像处理、机器学习和机理建模，同时关注人口暴露、公共健康与基于自然的解决方案。':'Her methods span spatial analysis, remote sensing, street-view image processing, machine learning and mechanistic modelling, with wider interests in population exposure, public health and nature-based solutions.'}</p><div class="profile-links"><a href={`mailto:${profile.email}`}><span>{zh?'邮箱':'Email'}</span>{profile.email}</a><a href={profile.linkedin}><span>LinkedIn</span>{zh?'查看个人主页 ↗':'View profile ↗'}</a><a href={profile.scholar}><span>Google Scholar</span>{zh?'查看学术成果 ↗':'View publications ↗'}</a><a href={profile.orcid}><span>ORCID</span>0009-0007-6204-397X ↗</a></div><div class="button-row"><a class="button" style="background:var(--night);color:white" href={profile.cv}>{zh?'下载简历':'Download CV'}</a></div></div></div></section>
</BaseLayout>
